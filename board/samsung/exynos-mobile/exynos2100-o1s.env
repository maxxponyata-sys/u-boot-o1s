stdin=button-kbd
stdout=vidconsole
stderr=vidconsole

bootdelay=2
bootmenu_delay=30

/* Use the initramfs in place inside the embedded FIT instead of copying it */
initrd_high=0xffffffffffffffff

bootpayload=if test -n "${payload_addr}"; then
		echo "Booting embedded FIT at ${payload_addr}";
		bootm ${payload_addr};
	else
		echo "No embedded FIT payload found";
	fi

bootcmd=run bootpayload; bootmenu

bootmenu_0=Boot Linux (embedded FIT)=run bootpayload
bootmenu_1=Reboot=reset
bootmenu_2=Power Off=poweroff

button_cmd_0_name=Volume Down Key
button_cmd_0=bootmenu
